---
import '../styles/global.css';
import { profile, links } from '../data/site.js';

const { title, description, current = '' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const nav = [
  { href: `${base}/#impact`, label: 'Impact' },
  { href: `${base}/#guardian`, label: 'Granite Guardian', short: 'Guardian' },
  { href: `${base}/#post-training`, label: 'Post-training' },
  { href: `${base}/#generative`, label: 'Generative modeling', short: 'Generative' },
  { href: `${base}/#adoption`, label: 'Adoption' },
  { href: `${base}/cv/`, label: 'CV', id: 'cv' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#f6f5f1" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0f0f0e" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap bar">
        <a class="brand" href={`${base}/`}>{profile.name}</a>
        <nav aria-label="Primary">
          {
            nav.map((item) => (
              <a href={item.href} aria-current={item.id && item.id === current ? 'page' : undefined}>
                {item.short ? (
                  <>
                    <span class="long">{item.label}</span>
                    <span class="short">{item.short}</span>
                  </>
                ) : (
                  item.label
                )}
              </a>
            ))
          }
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap foot">
        <div>
          <p class="foot-name">{profile.name}</p>
          <p class="foot-role">{profile.title}, {profile.org} · {profile.lab}</p>
        </div>
        <ul>
          <li><a href={links.scholar}>Google Scholar</a></li>
          <li><a href={links.linkedin}>LinkedIn</a></li>
          <li><a href={links.github}>GitHub</a></li>
          <li><a href={links.ibm}>IBM Research</a></li>
          <li><a href={links.mitibm}>MIT-IBM Watson AI Lab</a></li>
        </ul>
      </div>
    </footer>
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: -999px;
    top: 8px;
    background: var(--surface);
    padding: 8px 12px;
    border-radius: 6px;
    z-index: 20;
  }
  .skip:focus {
    left: 8px;
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--rule);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    min-height: 56px;
  }
  .brand {
    font-family: var(--serif);
    font-size: 1.15rem;
    font-weight: 500;
    color: var(--ink);
    text-decoration: none;
    white-space: nowrap;
  }
  nav {
    display: flex;
    gap: clamp(14px, 2.4vw, 28px);
    overflow-x: auto;
    scrollbar-width: none;
  }
  nav::-webkit-scrollbar {
    display: none;
  }
  nav a {
    color: var(--ink-2);
    text-decoration: none;
    font-size: 0.88rem;
    white-space: nowrap;
    padding-block: 6px;
  }
  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--ink);
  }

  .site-footer {
    border-top: 1px solid var(--rule);
    padding-block: 40px 56px;
    font-size: 0.9rem;
  }
  .foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 24px;
  }
  .foot p {
    margin: 0;
  }
  .foot-name {
    font-family: var(--serif);
    font-size: 1.1rem;
  }
  .foot-role {
    color: var(--ink-3);
  }
  .foot ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
  }

  .short {
    display: none;
  }

  @media (max-width: 640px) {
    .bar {
      flex-direction: column;
      align-items: flex-start;
      gap: 0;
      padding-block: 10px 4px;
    }
    nav {
      width: 100%;
      gap: 16px;
    }
    nav a {
      font-size: 0.84rem;
    }
    .long {
      display: none;
    }
    .short {
      display: inline;
    }
  }

  @media print {
    .site-header,
    .site-footer,
    .skip {
      display: none;
    }
  }
</style>
