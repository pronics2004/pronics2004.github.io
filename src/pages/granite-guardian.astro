---
import Base from '../layouts/Base.astro';
import Shot from '../components/Shot.astro';
import Timeline from '../components/Timeline.astro';
import Dumbbell from '../components/Dumbbell.astro';
import Bars from '../components/Bars.astro';
import aaChart from '../assets/aa-average-f1.png';
import guardianSpace from '../assets/space-granite-guardian.png';
import { models, guardbench, benchmark } from '../data/site.js';
import { quotes, adoption } from '../data/research.js';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const demo = 'https://huggingface.co/spaces/ibm-granite/granite-guardian';

const stats = [
  ['5th of 20', 'Artificial Analysis guardrail benchmark, and first among models that take their policy at runtime', benchmark.url],
  ['59 ms', 'per check on that benchmark, in no-think mode', benchmark.url],
  ['6 of top 10', 'places on GuardBench, across 40 datasets', guardbench.url],
  ['1.5M', 'downloads: 1.16M on Hugging Face, 371K on Ollama', models.guardian.hf],
];

// Granite Guardian 3.3 8B vs 4.1 8B, both in no-think mode. Source: the 4.1 model card.
const versionRows = [
  { label: 'IFEval multi-constraint', before: 0.458, after: 0.844 },
  { label: 'InfoBench, human-annotated', before: 0.535, after: 0.706 },
  { label: 'InfoBench, GPT-4-annotated', before: 0.585, after: 0.726 },
  { label: 'FC Reward Bench', before: 0.74, after: 0.79, beforeText: '0.74', afterText: '0.79' },
  { label: 'LLM-AggreFact average', before: 0.761, after: 0.76 },
];

const decisions = [
  ['A judge, not a classifier', 'It answers with a yes/no token and its probability, so the whole language model stays in play. That is what later let it take new criteria and serve as a reward model.'],
  ['Criteria at runtime', 'Since 4.1 the user writes the rule. Out-of-distribution safety F1 slipped from 0.81 to 0.79; custom-criteria accuracy on IFEval went from 0.46 to 0.84.'],
  ['Reasoning from the same weights', 'Think mode writes a justification first. It costs 59 ms to 1.3 s and pays back in tuning custom criteria and debugging verdicts.'],
];
---

<Base
  title="Granite Guardian · Prasanna Sattigeri"
  description="Granite Guardian, an open judge model for LLM agents: independent leaderboard results, releases and adoption."
  current="guardian"
>
  <section class="top">
    <div class="wrap">
      <p class="eyebrow"><a href={`${base}/`}>Home</a> / Granite Guardian</p>
      <h1>Granite Guardian</h1>
      <p class="lede">
        An open judge model for LLM agents. Give it a conversation and a criterion; it returns a verdict and a
        probability. I lead the team and own its releases, from data to open weights: five versions in eighteen months,
        shipped in watsonx and Red Hat’s Ask Red Hat.
      </p>
      <p class="actions">
        <a class="btn primary" href={demo}>Try the demo</a>
        <a class="btn" href={models.guardian.hf}>Model card</a>
        <a class="btn" href={models.guardian.paper}>NAACL 2025 paper</a>
        <a class="btn" href={models.guardian.github}>GitHub</a>
      </p>
      <dl class="stats">
        {
          stats.map(([value, label, href]) => (
            <div>
              <dt>
                <a href={href}>{label}</a>
              </dt>
              <dd>{value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Independent evaluation</p>
        <h2>On the leaderboards, and live</h2>
      </div>
      <div class="shots">
        <Shot
          src={aaChart}
          alt="Artificial Analysis bar chart of average F1 for guardrail models. Granite Guardian 4.1 8B is the fifth bar at 85.9%."
          href={benchmark.url}
          caption="Fifth of 20 by F1 (0.859), within 0.03 of the leader, with one broad policy written by Artificial Analysis. June 2026."
          source="Artificial Analysis"
        />
        <Shot
          src={guardianSpace}
          alt="The Granite Guardian demo on Hugging Face, with a custom criterion for personal data entered in the setup panel."
          href={demo}
          caption="The hosted demo: pick a use case or write your own criterion, and see the verdict and its reasoning."
          source="Hugging Face Space"
        />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Releases</p>
        <h2>Five versions in eighteen months</h2>
      </div>
      <Timeline />
      <div class="split">
        <Dumbbell
          title="What 4.1 added over 3.3"
          sub="Balanced accuracy, 8B, no-think mode. Source: the 4.1 model card."
          rows={versionRows}
          min={0.4}
          max={0.9}
          ticks={[0.4, 0.5, 0.6, 0.7, 0.8, 0.9]}
          beforeLabel="Guardian 3.3"
          afterLabel="Guardian 4.1"
          labelWidth={196}
        />
        <div class="beside">
          <p class="big">70.3</p>
          <p>
            Best-of-N score on the verifiable JETTS tasks as a reward model, ahead of Skywork-Reward 27B (68.7) and
            SFR-Judge 70B (68.2).
          </p>
          <p class="big">0.57 → 0.84</p>
          <p>IFEval balanced accuracy: the base Granite 4.1 8B prompted as a judge, then post-trained as Guardian.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Design</p>
        <h2>Three decisions</h2>
      </div>
      <ol class="decisions">
        {
          decisions.map(([head, body], i) => (
            <li class="card">
              <span class="n">0{i + 1}</span>
              <h3>{head}</h3>
              <p>{body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Adoption</p>
        <h2>In products, open source and other people’s studies</h2>
      </div>
      <div class="quotes">
        {
          quotes.map((q) => (
            <figure class="card quote">
              <blockquote>“{q.quote}”</blockquote>
              <figcaption>
                <a href={q.url}>{q.who}</a>
              </figcaption>
            </figure>
          ))
        }
      </div>
      <div class="use">
        <Bars />
        <div class="adoption">
          {
            adoption
              .filter((g) => g.head !== 'Research others have built on')
              .map((g) => (
                <div>
                  <h3>{g.head}</h3>
                  <ul>
                    {g.items.map((i) => (
                      <li>
                        <a href={i.url}>{i.text}</a>
                      </li>
                    ))}
                  </ul>
                </div>
              ))
          }
        </div>
      </div>
      <p class="more">
        The same post-training recipe adds capabilities to Granite models, composed by{' '}
        <a href={`${base}/granite-switch/`}>Granite Switch</a>.
      </p>
    </div>
  </section>
</Base>

<style>
  .top {
    padding-block: clamp(40px, 7vw, 88px) clamp(40px, 6vw, 64px);
  }
  .top h1 {
    margin-bottom: 18px;
  }
  .eyebrow a {
    color: inherit;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 24px 0 0;
  }
  .stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px 28px;
    margin: clamp(32px, 5vw, 52px) 0 0;
    padding-top: 22px;
    border-top: 1px solid var(--rule-strong);
  }
  .stats div {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: 6px;
  }
  .stats dd {
    margin: 0;
    font-size: clamp(1.7rem, 3vw, 2.3rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }
  .stats dt {
    font-size: 0.86rem;
    line-height: 1.45;
  }
  .stats dt a {
    color: var(--ink-2);
    text-decoration-color: var(--rule-strong);
  }
  .shots {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(20px, 3vw, 36px);
  }
  .split {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    gap: clamp(20px, 4vw, 48px);
    margin-top: clamp(32px, 5vw, 56px);
    align-items: start;
  }
  .beside p {
    margin: 0 0 18px;
    color: var(--ink-2);
    font-size: 0.92rem;
  }
  .beside .big {
    margin: 0 0 4px;
    font-size: 1.9rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--ink);
  }
  .decisions {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
  }
  .decisions li {
    padding: 22px;
  }
  .decisions .n {
    font-family: var(--mono);
    font-size: 0.75rem;
    color: var(--ink-3);
  }
  .decisions h3 {
    margin: 8px 0 8px;
    font-size: 1.15rem;
  }
  .decisions p {
    margin: 0;
    font-size: 0.92rem;
    color: var(--ink-2);
  }
  .quotes {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
  }
  .quote {
    margin: 0;
    padding: 22px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .quote blockquote {
    margin: 0;
    font-family: var(--serif);
    font-size: 1.12rem;
    line-height: 1.35;
  }
  .quote figcaption {
    margin-top: auto;
    font-size: 0.84rem;
  }
  .use {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.3fr);
    gap: clamp(20px, 4vw, 48px);
    margin-top: clamp(28px, 4vw, 44px);
    align-items: start;
  }
  .adoption {
    display: grid;
    gap: 22px;
  }
  .adoption h3 {
    font-family: var(--sans);
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: 0;
    margin: 0 0 8px;
  }
  .adoption ul {
    margin: 0;
    padding-left: 1.1em;
    display: grid;
    gap: 6px;
    font-size: 0.88rem;
    color: var(--ink-2);
  }
  .adoption a {
    color: inherit;
    text-decoration-color: var(--rule-strong);
  }
  .adoption a:hover {
    color: var(--link);
  }
  .more {
    margin: clamp(28px, 4vw, 44px) 0 0;
    color: var(--ink-2);
  }
  @media (max-width: 860px) {
    .stats {
      grid-template-columns: 1fr 1fr;
    }
    .shots,
    .split,
    .decisions,
    .quotes,
    .use {
      grid-template-columns: 1fr;
    }
  }
</style>
