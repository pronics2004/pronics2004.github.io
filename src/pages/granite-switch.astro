---
import Base from '../layouts/Base.astro';
import Shot from '../components/Shot.astro';
import Dumbbell from '../components/Dumbbell.astro';
import AgentLoop from '../components/AgentLoop.astro';
import evalsShot from '../assets/space-granitelib-evals.png';
import speechShot from '../assets/space-speech-to-decisions.png';
import { models, switchUrls } from '../data/site.js';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const evals = 'https://huggingface.co/spaces/ibm-granite/granitelib-evals';
const speech = 'https://huggingface.co/spaces/ibm-granite/speech-to-decisions';
const blog = switchUrls.blog;
const collection = 'https://huggingface.co/collections/ibm-granite/granite-libraries';

const stats = [
  ['+17 pts', 'on IFEval over the best generalist decision model, from the requirement-check adapter', evals],
  ['0.57 → 0.86', 'IFEval balanced accuracy, Granite 4.1 8B prompted vs post-trained', models.coreLib.hf],
  ['60–100 / s', 'decisions from a 3B Switch model playing Doom, against 10 a second reported for Jev', switchUrls.blog],
  ['13 in < 0.2 s', 'decisions on live speech from one endpoint, in the speech demo', speech],
];

const capabilities = [
  ['Judging against a criterion', 'yes or no, with a risk score', 'human-labeled and synthetic data for safety, RAG and tool calls'],
  ['Policy compliance', 'compliant, non-compliant or ambiguous', 'human-written policies across about 40 domains'],
  ['Factuality detection', 'yes if any claim is unsupported by the context', '17,522 ELI5 instances, half with injected errors'],
  ['Factuality correction', 'a corrected response, or none', 'the same corpus, supervised by FactCorrector (ACL 2026)'],
  ['Requirement checking', 'yes or no, with P(yes)', 'multi-constraint prompts with programmatic labels'],
  ['Calibrated uncertainty', 'a confidence that is right about X% of the time at X%', '240K answers per base model, labeled by a Thermometer calibrator'],
  ['Context attribution', 'the context sentences behind each response sentence, ranked', '4,101 conversation rounds labeled with leave-one-out MExGen'],
];

const requirementRows = [
  { label: 'Granite 4.1 3B', before: 0.5118, after: 0.8425 },
  { label: 'Granite 4.1 8B', before: 0.5689, after: 0.8554 },
  { label: 'Granite 4.1 30B', before: 0.6237, after: 0.8492 },
];
const uncertaintyRows = [
  { label: 'Granite 4.0 micro', before: 0.6748, after: 0.6903 },
  { label: 'Granite 4.1 3B', before: 0.6291, after: 0.7713 },
  { label: 'Granite 4.1 8B', before: 0.6439, after: 0.7778 },
  { label: 'Granite 4.1 30B', before: 0.6507, after: 0.8017 },
];
const halfTicks = [0.5, 0.6, 0.7, 0.8, 0.9];
---

<Base
  title="Granite Switch · Prasanna Sattigeri"
  description="Granite Switch and the Granite libraries: modular post-training that adds capabilities for reasoning, safety and agentic workloads to Granite models, composed into one model."
  current="switch"
>
  <section class="top">
    <div class="wrap">
      <p class="eyebrow"><a href={`${base}/`}>Home</a> / Granite Switch</p>
      <h1>Granite Switch</h1>
      <p class="lede">
        Modular post-training for Granite 4.1. Each capability for reasoning, safety and agentic workloads is trained on
        its own as an adapter in the Granite libraries, and Granite Switch composes them into one model that serves
        chat, decisions and speech from a single endpoint. I lead the Guardian and Core libraries and the general-purpose
        Decision adapter.
      </p>
      <p class="actions">
        <a class="btn primary" href={speech}>Try the speech demo</a>
        <a class="btn" href={switchUrls.repo}>Granite Switch on GitHub</a>
        <a class="btn" href={switchUrls.collection}>Switch models</a>
        <a class="btn" href={blog}>Release blog, Oct 2026</a>
      </p>
      <dl class="stats">
        {
          stats.map(([value, label, href]) => (
            <div>
              <dt>
                <a href={href}>{label}</a>
              </dt>
              <dd>{value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Composition</p>
        <h2>From libraries to one model</h2>
      </div>
      <figure class="compose" aria-label="Adapters from three Granite libraries are composed with the base model and a speech encoder into one Granite Switch model with one endpoint.">
        <div class="col">
          <p class="k">Granite libraries</p>
          <a class="lib card" href={models.guardianLib.hf}><strong>Guardian</strong><span>safety, policy, factuality, tool calls</span><em>I lead</em></a>
          <a class="lib card" href={models.coreLib.hf}><strong>Core</strong><span>requirements, uncertainty, attribution</span><em>I lead</em></a>
          <a class="lib card" href={collection}><strong>RAG</strong><span>answerability, hallucination, query clarification</span></a>
        </div>
        <span class="arrow" aria-hidden="true">→</span>
        <div class="col">
          <p class="k">Granite Switch 4.1, 8B or 30B</p>
          <a class="switch card" href={switchUrls.repo}>
            <span class="row">Granite 4.1 base model</span>
            <span class="row acc">Decision adapter, for any yes/no question <em>I lead</em></span>
            <span class="row acc">Library adapters, chosen per request</span>
            <span class="row">Speech encoder</span>
            <small>About the same GPU memory as the base model alone. Adapters reuse the base model’s KV cache.</small>
          </a>
        </div>
        <span class="arrow" aria-hidden="true">→</span>
        <div class="col">
          <p class="k">One endpoint</p>
          <div class="out card"><span>Chat</span><span>Decisions</span><span>Speech to text</span></div>
        </div>
      </figure>
      <p class="more">
        The 4.1 release ships with a set of adapters built in; anyone can <a href={switchUrls.repo}>compose their own</a>{' '}
        Switch model from the library adapters.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Results</p>
        <h2>Against generalist decision models</h2>
      </div>
      <Shot
        src={evalsShot}
        alt="Scoreboard comparing the best Granite adapter (blue dot) with four generalist decision models on 11 benchmarks. Granite leads on 8."
        href={evals}
        caption="Best Granite adapter (blue) against four generalist decision models: Jev 1.13, Microsoft-Decision-1, GPT-Luna-Decisions and Clef-Flash. Ahead on 8 of 11 benchmarks, by up to 17 points; behind on LLM-AggreFact and InfoBench."
        source="Granitelib evaluations, Hugging Face Space"
        sizes="(max-width: 1200px) 100vw, 1120px"
      />
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="split">
        <div>
          <p class="eyebrow">Live</p>
          <h2>Thirteen decisions from one endpoint</h2>
          <p class="body">
            The adapters share the base model’s KV cache, so each extra check costs almost nothing. In the demo, the
            Guardian adapter screens live speech while a general decision adapter answers every yes/no question,
            together in under 0.2 seconds.
          </p>
          <p class="body"><a href={blog}>How it works, on the Hugging Face blog</a></p>
        </div>
        <Shot
          src={speechShot}
          alt="The Speech to Decisions demo: a pizza-order transcript on the left; on the right, a safety check reading Nothing harmful and yes/no questions with scores."
          href={speech}
          caption="A pizza order, transcribed, labeled and screened as it is spoken."
          source="Speech to Decisions, Hugging Face Space"
        />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Post-training</p>
        <h2>The gain over the same model, prompted</h2>
      </div>
      <div class="charts">
        <Dumbbell
          title="Requirement checking"
          sub="IFEval multi-constraint, balanced accuracy. Chance is 0.5."
          rows={requirementRows}
          min={0.5}
          max={0.9}
          ticks={halfTicks}
          beforeLabel="Prompted"
          afterLabel="Post-trained"
          source="Source: Requirement Check model card."
        />
        <Dumbbell
          title="Calibrated uncertainty"
          sub="MMLU, AUROC for telling right answers from wrong. Chance is 0.5."
          rows={uncertaintyRows}
          min={0.5}
          max={0.9}
          ticks={halfTicks}
          beforeLabel="Sequence probability"
          afterLabel="Post-trained"
          source="14,042 held-out questions. Source: Uncertainty model card."
        />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Capabilities</p>
        <h2>Seven checks, placed in the agent loop</h2>
      </div>
      <AgentLoop />
      <details class="data">
        <summary>What each capability returns and what it was trained on</summary>
        <div class="table-scroll">
          <table class="caps">
            <thead>
              <tr>
                <th>Capability</th>
                <th>Returns</th>
                <th>Trained on</th>
              </tr>
            </thead>
            <tbody>
              {
                capabilities.map(([name, returns, trained]) => (
                  <tr>
                    <td>{name}</td>
                    <td>{returns}</td>
                    <td>{trained}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </details>
      <p class="more">
        Two of the seven started as papers: Thermometer became calibrated uncertainty, MExGen became context attribution.
        See <a href={`${base}/research/`}>research</a>, and the full <a href={collection}>collection on Hugging Face</a>.
      </p>
    </div>
  </section>
</Base>

<style>
  .top {
    padding-block: clamp(40px, 7vw, 88px) clamp(40px, 6vw, 64px);
  }
  .top h1 {
    margin-bottom: 18px;
  }
  .eyebrow a {
    color: inherit;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 24px 0 0;
  }
  .stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px 28px;
    margin: clamp(32px, 5vw, 52px) 0 0;
    padding-top: 22px;
    border-top: 1px solid var(--rule-strong);
  }
  .stats div {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: 6px;
  }
  .stats dd {
    margin: 0;
    font-size: clamp(1.6rem, 2.8vw, 2.2rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.1;
    white-space: nowrap;
  }
  .stats dt {
    font-size: 0.86rem;
    line-height: 1.45;
  }
  .stats dt a {
    color: var(--ink-2);
    text-decoration-color: var(--rule-strong);
  }
  .split {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(24px, 4vw, 56px);
    align-items: center;
  }
  .split h2 {
    margin-bottom: 16px;
  }
  .body {
    color: var(--ink-2);
  }
  .charts {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
    align-items: start;
  }
  .data {
    margin-top: clamp(24px, 4vw, 40px);
  }
  .data summary {
    cursor: pointer;
    font-weight: 500;
    color: var(--ink-2);
    margin-bottom: 12px;
  }
  .caps td {
    font-size: 0.9rem;
    color: var(--ink-2);
    padding-block: 10px;
  }
  .caps td:first-child {
    color: var(--ink);
    font-weight: 600;
    min-width: 170px;
  }
  .caps td:nth-child(2) {
    min-width: 200px;
  }
  .caps td:nth-child(3) {
    min-width: 240px;
  }
  .more {
    margin: clamp(24px, 4vw, 40px) 0 0;
    color: var(--ink-2);
  }
  .compose {
    margin: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1.1fr) auto minmax(0, 0.7fr);
    gap: 16px;
    align-items: center;
  }
  .col {
    display: grid;
    gap: 10px;
  }
  .k {
    margin: 0 0 2px;
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .compose a.card {
    color: inherit;
    text-decoration: none;
  }
  .compose a.card:hover {
    border-color: var(--ink-3);
  }
  .lib {
    display: grid;
    gap: 2px;
    padding: 12px 14px;
  }
  .lib span {
    font-size: 0.84rem;
    color: var(--ink-2);
  }
  .lib em {
    font-style: normal;
    font-family: var(--mono);
    font-size: 0.7rem;
    color: var(--accent);
  }
  .switch {
    display: grid;
    gap: 8px;
    padding: 16px;
    border-left: 3px solid var(--accent);
  }
  .switch .row {
    padding: 8px 10px;
    border: 1px solid var(--rule);
    border-radius: 6px;
    font-size: 0.9rem;
  }
  .switch .acc {
    border-color: var(--accent);
  }
  .switch .row em {
    font-style: normal;
    font-family: var(--mono);
    font-size: 0.7rem;
    color: var(--accent);
    margin-left: 6px;
  }
  .switch small {
    font-size: 0.8rem;
    color: var(--ink-3);
  }
  .out {
    display: grid;
    gap: 8px;
    padding: 16px;
  }
  .out span {
    font-weight: 600;
  }
  .arrow {
    font-size: 1.4rem;
    color: var(--ink-3);
  }
  @media (max-width: 860px) {
    .compose {
      grid-template-columns: 1fr;
    }
    .arrow {
      transform: rotate(90deg);
      justify-self: center;
    }
    .stats {
      grid-template-columns: 1fr 1fr;
    }
    .split,
    .charts {
      grid-template-columns: 1fr;
    }
  }
</style>
