---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import photo from '../assets/profile.png';
import { profile, links, scholar, models, benchmark, guardbench, awards } from '../data/site.js';
import { publications } from '../data/publications.js';
import { collaborators } from '../data/research.js';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const pub = Object.fromEntries(publications.filter((p) => p.id).map((p) => [p.id, p]));

const ext = {
  watsonxAi: 'https://www.ibm.com/docs/en/watsonx/w-and-w/2.2.0?topic=prompts-ai-guardrails-filter-content',
  watsonxGov: 'https://www.ibm.com/docs/SSLSRPV_2.2.x/fixlist/watsonxgov-fixlist.html',
  askRedHat: 'https://access.redhat.com/ai/system-card/ask-red-hat',
  ollama: 'https://ollama.com/library/granite3-guardian',
  aggrefact: 'https://llm-aggrefact.github.io/',
  aif360: 'https://github.com/Trusted-AI/AIF360',
  aix360: 'https://github.com/Trusted-AI/AIX360',
  uq360: 'https://github.com/IBM/UQ360',
  rpi: 'https://www.rpi.edu/',
};

// What to show under "Selected work": released models first, then papers, then toolkits.
const selected = [
  {
    title: 'Granite Guardian',
    what: 'An open judge model. Give it a conversation and a criterion, built in or written by you; it answers yes or no, with a probability, in 59 ms.',
    meta: 'Model, five releases since 2024 · project and training lead',
    links: [
      [`${base}/granite-guardian/`, 'case study'],
      [models.guardian.hf, 'model card'],
      [models.guardian.paper, 'NAACL 2025'],
      [models.guardian.github, 'code'],
    ],
  },
  {
    title: 'Modular post-training for Granite',
    what: 'Seven capabilities trained into Granite 4.1 one at a time: requirement checks, calibrated uncertainty, context attribution, policy compliance, factuality detection and correction. IFEval balanced accuracy 0.569 to 0.855 on 8B.',
    meta: 'Guardian and Core capability libraries, 2026 · lead',
    links: [
      [`${base}/research/#post-training`, 'how it works'],
      [models.guardianLib.hf, 'Guardian library'],
      [models.coreLib.hf, 'Core library'],
    ],
  },
  { ...pub['decocted'], links: [[pub['decocted'].url, 'paper']] },
  { ...pub['agentic-guardrail'], links: [[pub['agentic-guardrail'].url, 'paper']] },
  { ...pub['trace-inversion'], links: [[pub['trace-inversion'].url, 'paper']] },
  { ...pub['thermometer'], links: [[pub['thermometer'].url, 'paper']] },
  { ...pub['dip-vae'], links: [[pub['dip-vae'].url, 'paper'], ['https://github.com/google-research/disentanglement_lib', 'in disentanglement_lib']] },
  {
    title: 'AI Fairness 360, AI Explainability 360, UQ360',
    what: 'Open-source toolkits for fairness, explanation and uncertainty. AIF360 is a Linux Foundation project; its paper has 2,937 citations.',
    meta: 'Toolkits, 2018 to 2021 · core contributor',
    links: [
      [ext.aif360, 'AIF360'],
      [ext.aix360, 'AIX360'],
      [ext.uq360, 'UQ360'],
    ],
  },
].map((s) => ({
  title: s.title,
  what: s.what ?? s.summary,
  meta: s.meta ?? `${s.venue} ${s.year}${s.note ? ' · ' + s.note.toLowerCase() : ''}`,
  links: s.links,
}));

const recognition = [
  [benchmark.url, 'Artificial Analysis guardrail benchmark, June 2026', 'Granite Guardian 4.1 8B fifth of 20 by F1, first among models that take their policy at runtime.'],
  [ext.aggrefact, 'LLM-AggreFact leaderboard', 'Granite Guardian 3.3 8B third of 39, ahead of GPT-4o, Mistral Large 2 and Llama 3.1 405B.'],
  [guardbench.url, 'GuardBench, EC Joint Research Centre, April 2025', 'Six of the top ten places across 40 datasets.'],
  [`${base}/research/#impact`, 'IBM Research awards', 'Outstanding Accomplishment in 2024 and 2025; Technical Achievement Awards from 2019 to 2025.'],
];
---

<Base
  title="Prasanna Sattigeri"
  description="Prasanna Sattigeri leads post-training for agent reliability at IBM Research: Granite Guardian, modular post-training for Granite models, and research in agents, calibration and generative modeling."
  current="home"
  width="narrow"
>
  <section class="intro">
    <div class="wrap">
      <div class="who">
        <Image class="photo" src={photo} alt="Portrait of Prasanna Sattigeri" width={320} height={320} loading="eager" />
        <div>
          <h1>{profile.name}</h1>
          <p class="role">
            {profile.title}, <a href={links.ibm}>{profile.org}</a> · <a href={links.mitibm}>{profile.lab}</a>
          </p>
          <p class="links">
            <a href={links.scholar}>Google Scholar</a>
            <a href={links.github}>GitHub</a>
            <a href={links.linkedin}>LinkedIn</a>
            <a href={links.x}>X</a>
            <a href={`${base}/cv/`}>CV</a>
          </p>
        </div>
      </div>

      <p>
        I lead post-training for agent reliability at <a href={links.ibm}>IBM Research</a> and designed{' '}
        <a href={`${base}/granite-guardian/`}>Granite Guardian</a>, an open judge model. It is a judge rather than a
        classifier: it answers with a yes/no token and its probability, takes criteria written at runtime instead of a
        fixed taxonomy, and can reason before it answers, a trace people also use to refine their criteria and debug
        verdicts. The team also adds capabilities to Granite models through{' '}
        <a href={`${base}/research/#post-training`}>modular post-training</a> for reasoning, safety and agentic
        workloads: tool-call checks, groundedness, requirements, factuality, confidence. Granite Guardian 4.1 ranks
        fifth of 20 on the <a href={benchmark.url}>Artificial Analysis guardrail benchmark</a> at 59 ms per check. The
        models run in <a href={ext.watsonxAi}>watsonx.ai</a>, <a href={ext.watsonxGov}>watsonx.governance</a> and Red
        Hat’s <a href={ext.askRedHat}>Ask Red Hat</a> assistant, with 1.16M downloads on{' '}
        <a href={models.guardian.hf}>Hugging Face</a> and 371K on <a href={ext.ollama}>Ollama</a>.
      </p>
      <p>
        Deep expertise in generative modeling, starting with <a href={pub['dip-vae'].url}>VAEs</a> and{' '}
        <a href={pub['ssl-gan'].url}>GANs</a> (ICLR 2018, NeurIPS 2017) and now diffusion models, LLMs and agentic
        systems (<a href={pub['decocted'].url}>COLM 2026</a>, <a href={pub['agentic-guardrail'].url}>ICLR 2026</a>,{' '}
        <a href={pub['trace-inversion'].url}>ACL 2026</a>), with calibration and uncertainty running through all of it
        (<a href={pub['thermometer'].url}>ICML 2024</a>, <a href={pub['edl-mirage'].url}>NeurIPS 2024</a>). Principal
        investigator on joint projects with <a href={links.mitibm}>MIT</a> and <a href={ext.rpi}>RPI</a>. Core
        contributor to <a href={ext.aif360}>AI Fairness 360</a>, <a href={ext.aix360}>AI Explainability 360</a> and{' '}
        <a href={ext.uq360}>UQ360</a>. <a href={links.scholar}>{scholar.citations.toLocaleString('en-US')} citations,
        h-index {scholar.hIndex}</a> (Google Scholar, {scholar.asOf}).
      </p>
    </div>
  </section>

  <section class="block">
    <div class="wrap">
      <h2>Selected work</h2>
      <ol class="work">
        {
          selected.map((s) => (
            <li>
              <p class="w-title">{s.title}</p>
              <p class="w-what">{s.what}</p>
              <p class="w-meta">
                <span>{s.meta}</span>
                {s.links.map(([href, label]) => (
                  <a href={href}>{label}</a>
                ))}
              </p>
            </li>
          ))
        }
      </ol>
      <p class="more">
        More on the <a href={`${base}/research/`}>research</a> page: post-training recipe and results, agent workflow
        map, generative modeling, open source, adoption. All papers under <a href={`${base}/publications/`}>publications</a>.
      </p>
    </div>
  </section>

  <section class="block">
    <div class="wrap">
      <h2>Recognition</h2>
      <ul class="plain">
        {
          recognition.map(([href, head, body]) => (
            <li>
              <a href={href}>{head}</a>. {body}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="block">
    <div class="wrap">
      <h2>Academic collaborations</h2>
      <ul class="plain">
        {
          collaborators.map((c) => (
            <li>
              <strong>{c.place}</strong>: {c.people}; with {c.with}. {c.topics}.
            </li>
          ))
        }
      </ul>
      <p class="fine">
        Thesis committees for Joshua Lee and Maohao Shen at MIT and Burak Varıcı at RPI. Associate Editor, Pattern
        Recognition; area chair at NeurIPS, ICML, ICLR and AAAI; IEEE Senior Member.
      </p>
    </div>
  </section>
</Base>

<style>
  .intro {
    padding-block: clamp(40px, 6vw, 72px) clamp(16px, 3vw, 28px);
  }
  .intro p {
    font-size: 1.04rem;
    line-height: 1.65;
  }
  .who {
    display: flex;
    align-items: center;
    gap: clamp(20px, 3vw, 32px);
    margin-bottom: clamp(24px, 4vw, 36px);
  }
  .intro :global(.photo) {
    width: clamp(96px, 14vw, 132px);
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 50%;
    border: 1px solid var(--rule);
    flex-shrink: 0;
  }
  .intro h1 {
    font-size: clamp(2rem, 4.4vw, 2.7rem);
    letter-spacing: -0.015em;
  }
  .role {
    margin: 6px 0 0;
    font-size: 0.95rem !important;
    color: var(--ink-2);
  }
  .role a {
    color: inherit;
    text-decoration-color: var(--rule-strong);
  }
  .links {
    margin: 8px 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 4px 16px;
    font-size: 0.9rem !important;
  }

  .block {
    padding-block: clamp(20px, 3vw, 32px) clamp(24px, 3vw, 36px);
  }
  .block h2 {
    font-size: 1.35rem;
    padding-bottom: 10px;
    margin-bottom: 18px;
    border-bottom: 1px solid var(--rule);
  }
  .work {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 20px;
  }
  .work p {
    margin: 0;
  }
  .w-title {
    font-weight: 600;
    line-height: 1.4;
  }
  .w-what {
    margin-top: 2px !important;
    color: var(--ink-2);
    font-size: 0.95rem;
  }
  .w-meta {
    margin-top: 4px !important;
    font-size: 0.84rem;
    color: var(--ink-3);
    display: flex;
    flex-wrap: wrap;
    gap: 2px 12px;
  }
  .w-meta a {
    color: var(--link);
  }
  .more {
    margin: 24px 0 0;
    font-size: 0.92rem;
    color: var(--ink-2);
  }
  .plain {
    margin: 0;
    padding-left: 1.1em;
    display: grid;
    gap: 10px;
    color: var(--ink-2);
    font-size: 0.95rem;
  }
  .plain strong {
    color: var(--ink);
    font-weight: 600;
  }
  .fine {
    margin: 16px 0 0;
    font-size: 0.88rem;
    color: var(--ink-3);
  }
  @media (max-width: 520px) {
    .who {
      align-items: flex-start;
    }
  }
</style>
